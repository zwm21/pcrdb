# pcrdb Configuration Example
# Copy this file to .env and fill in values
#
# 双渠道说明:
#   qsdk = 渠道服 (默认), bsdk = B服 (bilibili 官服)
#   每个渠道有独立的数据库配置组与 config/*.json 账号文件,
#   采集时通过 PCRDB_CHANNEL / cli --channel / daily_sync 交互选择目标渠道。

# 默认采集渠道: qsdk / bsdk
PCRDB_CHANNEL=qsdk

# === 渠道服数据库 ===
# 无前缀变量 (PCRDB_*) 是渠道服的历史配置, docker-compose 也使用这组变量;
# 如需显式区分, 可用 PCRDB_QSDK_HOST / PCRDB_QSDK_PORT / PCRDB_QSDK_DATABASE /
# PCRDB_QSDK_USER / PCRDB_QSDK_PASSWORD 覆盖 (优先级更高)。
PCRDB_HOST=localhost
PCRDB_PORT=5432
PCRDB_DATABASE=your_database
PCRDB_USER=your_user
PCRDB_PASSWORD=your_password

# === B服数据库 (同一 PostgreSQL 实例, 不同 database 名) ===
# 使用前: CREATE DATABASE pcrdb_bsdk; 然后 python scripts/apply_schema.py --channel bsdk
PCRDB_BSDK_HOST=localhost
PCRDB_BSDK_PORT=5432
PCRDB_BSDK_DATABASE=pcrdb_bsdk
PCRDB_BSDK_USER=your_user
PCRDB_BSDK_PASSWORD=your_password

# B服极验过码服务 (base url, 不带路径; B站 SDK 登录触发验证码时使用, autopcr 同款公共服务)
PCRDB_GEETEST_API=https://pcrd.tencentbot.top

# 可选: 空库首次全量扫描的公会 ID 上限 (默认值见 src/pcrdb/channel.py)
# PCRDB_QSDK_FULL_SCAN_MAX=52000
# PCRDB_BSDK_FULL_SCAN_MAX=400000

# 可选: 分渠道并发覆盖 (缺省用下方全局值; B服登录含 SDK 往返, 建议调小)
# PCRDB_BSDK_SYNC_NUM=5

# Task Queue
PCRDB_SYNC_NUM=10
PCRDB_BATCH_SIZE=30

# Shared Access Key (for all accounts, 仅渠道服使用)
PCRDB_ACCESS_KEY=your_access_key_here

# Game Config
TALENT_QUEST_TOTAL=250

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8080

# External APIs
CLAN_BATTLE_API_URL="http://localhost:8000"
